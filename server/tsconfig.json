{
  // Top Level
  "include": ["src/**/*"],

  "compilerOptions": {
    // Modules
    "module": "nodenext",
    "paths": {
      "@server": ["./src/index"],
      "@controllers/*": ["./src/controllers/*"],
      "@events/*": ["./src/events/*"],
      "@lib/*": ["./src/lib/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@typeResolvers/*": ["./src/resolvers/typeResolvers/*"],
      "@services/*": ["./src/services/*"],
      "@appTypes": ["./src/types/index.ts"],
      "@appTypes/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@validators/*": ["./src/validators/*"]
    },
    "types": ["node"],
    "rootDir": "./src",

    // Language and Environment
    "lib": ["ES2025"],
    "target": "es2025",

    // Interop Constraints
    "forceConsistentCasingInFileNames": true,

    // Type Checking
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,

    // Emit
    "removeComments": true,
    "noEmitOnError": true,
    "outDir": "build",

    // Completeness
    "skipLibCheck": true
  }
}
