{
  "name": "fawllerspeaks-app",
  "version": "1.0.0",
  "private": true,
  "main": "build/index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "test": "cross-env NODE_ENV=test jest --watch --runInBand",
    "codegen": "graphql-codegen --config codegen.yml",
    "dev": "cross-env NODE_ENV=development ts-node-dev -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "demo": "cross-env NODE_ENV=demo node build/index.js",
    "start": "cross-env NODE_ENV=production node build/index.js"
  },
  "license": "MIT",
  "engines": {
    "node": "v24.16.0",
    "npm": "11.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.6",
    "@babel/preset-env": "^7.19.4",
    "@babel/preset-typescript": "^7.18.6",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "2.13.11",
    "@graphql-codegen/typescript": "2.8.1",
    "@graphql-codegen/typescript-resolvers": "2.7.6",
    "@jest/globals": "^29.5.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/formidable": "^3.4.2",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.6.5",
    "@types/sanitize-html": "^2.11.0",
    "babel-jest": "^29.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "jest": "^29.5.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.2",
    "tsconfig-paths": "^4.1.1",
    "@appTypescript": "^6.0.3",
    "@appTypescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@apollo/server": "^4.1.0",
    "@supabase/supabase-js": "^2.33.1",
    "@types/nodemailer": "^7.0.2",
    "bcrypt": "^5.1.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "formidable": "^3.5.1",
    "graphql": "^16.6.0",
    "helmet": "^6.0.0",
    "joi": "^17.7.0",
    "jsonwebtoken": "^8.5.1",
    "nodemailer": "^7.0.9",
    "pg": "^8.8.0",
    "resend": "^6.7.0",
    "sanitize-html": "^2.13.0"
  }
}
